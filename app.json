{
  "expo": {
    "name": "Glove Mode",
    "slug": "muaythai-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "muaythai",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#111111",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.matijajanc.glovemode"
    },
    "android": {
      "package": "com.matijajanc.glovemode",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "muaythai"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Glove Mode listens for \"combo\" and \"timer\" voice commands while you switch the mic on.",
          "speechRecognitionPermission": "Glove Mode uses speech recognition to understand your \"combo\" and \"timer\" voice commands.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.samsung.android.bixby.agent"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#111111",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bbd10dd3-fa2b-4e45-9fc0-09d26d6643ab"
      }
    }
  }
}
