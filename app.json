{
  "expo": {
    "name": "Muay Thai",
    "slug": "muaythai-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "muaythai",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.yourname.muaythaiapp",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "muaythai"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Muay Thai listens for \"combo\" voice commands during training.",
          "speechRecognitionPermission": "Muay Thai uses speech recognition to detect \"combo\" voice commands.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.samsung.android.bixby.agent"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "bbd10dd3-fa2b-4e45-9fc0-09d26d6643ab"
      }
    }
  }
}
